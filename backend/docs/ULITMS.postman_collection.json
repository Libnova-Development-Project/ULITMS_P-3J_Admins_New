{
  "info": {
    "name": "ULITMS API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "admin_token",
      "value": ""
    },
    {
      "key": "student_token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST /auth/register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "description": "Register a student account\n\nPostgreSQL: PROCEDURE sp_register_user (+ trg_users_sanitize, trg_audit_users)",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"student_number\": \"2026-0100\",\n  \"first_name\": \"Ana\",\n  \"last_name\": \"Reyes\",\n  \"email\": \"ana@ulitms.edu\",\n  \"password\": \"Secret123!\",\n  \"course\": \"BSIS\",\n  \"year_level\": 2\n}"
            }
          }
        },
        {
          "name": "POST /auth/login (ADMIN - run first)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json(); if (j.success) pm.collectionVariables.set('admin_token', j.data.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@ulitms.edu\",\n  \"password\": \"Admin@123\"\n}"
            }
          }
        },
        {
          "name": "POST /auth/login (STUDENT Juan - run first)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json(); if (j.success) pm.collectionVariables.set('student_token', j.data.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"juan@ulitms.edu\",\n  \"password\": \"Student@123\"\n}"
            }
          }
        },
        {
          "name": "GET /auth/me",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{student_token}}"
              }
            ],
            "url": "{{baseUrl}}/auth/me",
            "description": "Current user profile\n\nPostgreSQL: SELECT users (column-limited)"
          }
        }
      ]
    },
    {
