            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Clean Code\",\n  \"author\": \"Robert Martin\",\n  \"isbn\": \"9780132350884\",\n  \"total_copies\": 2,\n  \"category_id\": 1\n}"
